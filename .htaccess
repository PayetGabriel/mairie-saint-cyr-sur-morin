# ══════════════════════════════════════════════════════════════
#  saint-cyr-sur-morin.fr — Apache .htaccess
#  Hébergement OVH (mutualisé)
# ══════════════════════════════════════════════════════════════

RewriteEngine On

# Désactive la négociation de contenu MultiViews (évite qu'Apache serve navbar.js
# à la place de navbar.html quand l'extension est absente de l'URL)
# et désactive l'affichage du contenu des dossiers (Index of)
Options -MultiViews -Indexes

# ── 0. Transmission du header Authorization à PHP ────────────────────────────
#    OVH/Apache mutualisé supprime ce header par défaut.
#    Cette règle le copie dans la variable d'environnement HTTP_AUTHORIZATION
#    que PHP lit ensuite via $_SERVER['REDIRECT_HTTP_AUTHORIZATION'].
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ── 1. Force HTTPS (301 permanent) ───────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── 2. URLs propres ──────────────────────────────────────────────────────────
# 2a. Redirection ciblée : du dossier /actualite vers la page /actualites
#     Ex : /la-commune/actualite ou /la-commune/actualite/ → /la-commune/actualites
RewriteRule ^la-commune/actualite/?$ /la-commune/actualites [R=301,L]

# 2b. Si la barre d'adresse contient .html, rediriger vers l'URL propre (301)
#     Exceptions : /components/ (fetch JS) et les pages qui ont un dossier
#     du même nom (actualites.html + actualite/) : on garde le .html
RewriteCond %{REQUEST_FILENAME} ^(.+)\.html$
RewriteCond %1 -d
RewriteRule ^ - [S=1]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/components/ [NC]
RewriteRule ^ /%1 [R=301,L]

# 2c. Servir le fichier .html en arrière-plan sans afficher l'extension
#     /la-commune/conseil  →  /la-commune/conseil.html
#     Ne s'applique pas si le fichier/dossier existe déjà tel quel
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# 2d. Page + dossier du même nom : /la-commune/actualites → actualites.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+[^/])$ $1.html [NC,L]

# ── 3. Réécriture des endpoints API sans extension ───────────────────────────
#    Permet d'appeler /api/admin-users au lieu de /api/admin-users.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/([^/]+)$ /api/$1.php [L]

# ── 4. Protection de /api/config.php contre l'accès direct ───────────────────
#    Tout accès direct → 403 Forbidden
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# ── 5. Blocage de l'exécution PHP dans /uploads/ ─────────────────────────────
#    Appliqué uniquement via le sous-fichier /uploads/.htaccess

# ── 6. Page d'erreur 404 personnalisée ───────────────────────────────────────
ErrorDocument 404 /404.html